---
import { site } from '../data/site';

interface Props {
  isHome: boolean;
}

// Links starting with # are sections of the home page: on the home page they scroll in place,
// elsewhere they jump back to the home page. Other links (like /about/) are separate pages.
const prefix = Astro.props.isHome ? '' : '/';
const links = [
  { href: '/about/', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
].map((l) => ({ ...l, href: l.href.startsWith('#') ? prefix + l.href : l.href }));
const current = Astro.url.pathname;
---

<header id="top">
  <div class="header-content">
    <a href={Astro.props.isHome ? '#top' : '/'} class="brand">{site.name}</a>
    <nav>
      {links.map((l) => <a href={l.href} aria-current={l.href === current ? 'page' : undefined}>{l.label}</a>)}
      <div class="nav-item dropdown">
        <a href="#contact" class="nav-link">Contact ▾</a>
        <div class="dropdown-menu">
          <div class="contact-text">{site.email}</div>
          <div class="contact-text">{site.phone}</div>
          <a href={site.github} target="_blank" rel="noopener">GitHub</a>
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </nav>
  </div>
</header>
