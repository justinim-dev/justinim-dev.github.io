---
import 'aos/dist/aos.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  footerTagline?: string;
}

const { title, description = `${site.name} — engineering portfolio`, footerTagline } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <Header isHome={isHome} />
    <main>
      <slot />
    </main>
    <Footer tagline={footerTagline} />
    <a href="#top" class="scroll-top" title="Back to top">&#8679;</a>

    <script>
      import AOS from 'aos';

      AOS.init({ duration: 600, easing: 'ease-out', once: true });

      // Shrink the sticky header once the page has scrolled a little.
      const header = document.querySelector('header');
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            header?.classList.toggle('shrink', window.scrollY > 80);
            ticking = false;
          });
        },
        { passive: true },
      );
    </script>
  </body>
</html>
